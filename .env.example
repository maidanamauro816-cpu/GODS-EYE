# Proxy regional ADS-B desplegado como Vercel Function.
# En Vercel se resuelve contra el mismo dominio: https://TU-PROYECTO.vercel.app/api/adsb
VITE_ADSB_PROXY=/api/adsb

# Opcional: proxy separado para el snapshot mundial OpenSky (mode=global).
# No lo reemplaza ADSB.lol; dejalo vacío si todavía no está desplegado.
VITE_TRAFFIC_PROXY_URL=
